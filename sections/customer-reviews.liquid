{%- comment -%}
  sections/customer-reviews.liquid
  Centered reviews slider: heading, stars, review title, review text, dots.
  Add review blocks in the theme editor.
{%- endcomment -%}

{%- liquid
  assign review_count = section.blocks.size
-%}

<section
  class="cr cr-{{ section.id }}"
  data-cr
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="cr__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="cr__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if review_count > 0 -%}
      <div class="cr__viewport" data-cr-viewport>
        <ul class="cr__track" data-cr-track>
          {%- for block in section.blocks -%}
            <li
              class="cr__slide{% if forloop.first %} is-active{% endif %}"
              data-cr-slide
              role="group"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} / {{ review_count }}"
              {{ block.shopify_attributes }}
            >
              <div class="cr__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    <span class="cr__star">&#9733;</span>
                  {%- else -%}
                    <span class="cr__star cr__star--empty">&#9733;</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if block.settings.title != blank -%}
                <p class="cr__title">{{ block.settings.title }}</p>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="cr__text">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.author != blank -%}
                <p class="cr__author">{{ block.settings.author }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if review_count > 1 -%}
        <div class="cr__dots" role="tablist" aria-label="Reviews">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="cr__dot{% if forloop.first %} is-active{% endif %}"
              data-cr-dot
              data-index="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ forloop.index }} / {{ review_count }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="cr__empty">Add review blocks in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .cr-{{ section.id }} {
    --cr-bg: {{ section.settings.bg_color }};
    --cr-text: {{ section.settings.text_color }};
    --cr-dot: {{ section.settings.dot_color }};
    --cr-dot-active: {{ section.settings.dot_active_color }};
    background: var(--cr-bg);
    color: var(--cr-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .cr-{{ section.id }} .cr__inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .cr-{{ section.id }} .cr__heading {
    margin: 0 0 28px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Slides sit in one grid cell and cross-fade, so height follows the tallest review */
  .cr-{{ section.id }} .cr__track {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cr-{{ section.id }} .cr__slide {
    grid-area: 1 / 1;
    visibility: hidden;
    pointer-events: none;
    /* stays visible just long enough for the outgoing fade */
    transition: visibility 0s 0.3s;
  }

  .cr-{{ section.id }} .cr__slide.is-active {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s;
  }

  /* Outgoing review: fades out in place, then silently resets below */
  .cr-{{ section.id }} .cr__slide > * {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.3s ease, transform 0s 0.3s;
  }

  /* Incoming review: each line rises from the bottom, one after another */
  .cr-{{ section.id }} .cr__slide.is-active > * {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.7s ease calc(var(--i, 0) * 0.1s),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 0.1s);
  }

  .cr-{{ section.id }} .cr__slide > :nth-child(1) { --i: 0; }
  .cr-{{ section.id }} .cr__slide > :nth-child(2) { --i: 1; }
  .cr-{{ section.id }} .cr__slide > :nth-child(3) { --i: 2; }
  .cr-{{ section.id }} .cr__slide > :nth-child(4) { --i: 3; }

  .cr-{{ section.id }} .cr__stars {
    margin-bottom: 18px;
    font-size: 14px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .cr-{{ section.id }} .cr__star--empty {
    opacity: 0.2;
  }

  .cr-{{ section.id }} .cr__title {
    margin: 0 0 18px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .cr-{{ section.id }} .cr__text {
    font-size: 13px;
    line-height: 1.9;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cr-{{ section.id }} .cr__text p {
    margin: 0;
  }

  .cr-{{ section.id }} .cr__author {
    margin: 18px 0 0;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .cr-{{ section.id }} .cr__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 44px;
  }

  /* 24px tap target around a 6px dot */
  .cr-{{ section.id }} .cr__dot {
    position: relative;
    width: 18px;
    height: 18px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .cr-{{ section.id }} .cr__dot::after {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: var(--cr-dot);
    transition: background 0.3s ease;
  }

  .cr-{{ section.id }} .cr__dot.is-active::after {
    background: var(--cr-dot-active);
  }

  .cr-{{ section.id }} .cr__dot:focus-visible {
    outline: 2px solid var(--cr-dot-active);
    outline-offset: 2px;
  }

  .cr-{{ section.id }} .cr__empty {
    font-size: 13px;
    opacity: 0.6;
  }

  @media (max-width: 749px) {
    .cr-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }
    .cr-{{ section.id }} .cr__text {
      font-size: 12px;
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cr-{{ section.id }} .cr__slide,
    .cr-{{ section.id }} .cr__slide > *,
    .cr-{{ section.id }} .cr__slide.is-active > *,
    .cr-{{ section.id }} .cr__dot::after {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.cr-{{ section.id }}');
    if (!root || root.dataset.crReady) return;
    root.dataset.crReady = 'true';

    var slides = root.querySelectorAll('[data-cr-slide]');
    var dots = root.querySelectorAll('[data-cr-dot]');
    var viewport = root.querySelector('[data-cr-viewport]');
    if (slides.length < 2) return;

    var current = 0;
    var timer = null;
    var autoplay = root.dataset.autoplay === 'true';
    var speed = (parseInt(root.dataset.speed, 10) || 5) * 1000;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach(function (s, i) {
        s.classList.toggle('is-active', i === current);
        s.setAttribute('aria-hidden', i === current ? 'false' : 'true');
      });
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === current);
        d.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
    }

    function start() {
      if (!autoplay || reduceMotion) return;
      stop();
      timer = setInterval(function () { show(current + 1); }, speed);
    }

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        show(parseInt(dot.dataset.index, 10));
        start();
      });
    });

    // Swipe on touch devices
    var startX = 0;
    viewport.addEventListener('touchstart', function (e) {
      startX = e.changedTouches[0].clientX;
      stop();
    }, { passive: true });
    viewport.addEventListener('touchend', function (e) {
      var diff = e.changedTouches[0].clientX - startX;
      if (Math.abs(diff) > 40) show(diff < 0 ? current + 1 : current - 1);
      start();
    }, { passive: true });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    // Theme editor: jump to the selected review block
    document.addEventListener('shopify:block:select', function (e) {
      var idx = Array.prototype.indexOf.call(slides, e.target);
      if (idx > -1 && root.contains(e.target)) { stop(); show(idx); }
    });
    document.addEventListener('shopify:block:deselect', function (e) {
      if (root.contains(e.target)) start();
    });

    show(0);
    start();
  })();
</script>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section-customer-reviews",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers are saying"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate reviews",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between reviews",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dots",
      "default": "#a6a6a6"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "So chic!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Beautiful quality and the personalization looks exactly as pictured. Arrived quickly and well packaged."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
