{% doc %}
  Returns Color option metadata and the visible media count for the selected variant.

  @param {object} product - The product whose Color or Colour option is inspected
  @param {object[]} media_items - The media items rendered by the gallery
  @param {object} variant - The selected or first available variant
  @param {string} page_type - The current Shopify page type

  @example
  {% render 'product-media-color-filter-state', product: product, media_items: product.media, variant: product.selected_or_first_available_variant, page_type: request.page_type %}
{% enddoc %}

{%- liquid
  assign color_option_position = 0
  if page_type == 'product'
    for product_option in product.options_with_values
      assign option_name = product_option.name | downcase
      if option_name == 'color' or option_name == 'colour'
        assign color_option_position = product_option.position
        break
      endif
    endfor
  endif

  assign selected_color_value = ''
  case color_option_position
    when 1
      assign selected_color_value = variant.option1
    when 2
      assign selected_color_value = variant.option2
    when 3
      assign selected_color_value = variant.option3
  endcase
  assign selected_color_key = selected_color_value | handleize
  assign has_selected_color_media = false
  assign initial_visible_media_count = media_items.size

  if color_option_position > 0 and selected_color_key != blank
    for media in media_items
      capture media_color
        render 'product-media-color-segment', media: media
      endcapture
      assign media_color = media_color | strip
      if media_color != 'all' and media_color == selected_color_key
        assign has_selected_color_media = true
        break
      endif
    endfor

    if has_selected_color_media
      assign initial_visible_media_count = 0
      for media in media_items
        capture media_color
          render 'product-media-color-segment', media: media
        endcapture
        assign media_color = media_color | strip
        if media_color == 'all' or media_color == selected_color_key
          assign initial_visible_media_count = initial_visible_media_count | plus: 1
        endif
      endfor
    endif
  endif

  assign has_color_option = false
  if color_option_position > 0
    assign has_color_option = true
  endif
-%}

{{- has_color_option -}}|{{- selected_color_key -}}|{{- has_selected_color_media -}}|{{- initial_visible_media_count -}}
