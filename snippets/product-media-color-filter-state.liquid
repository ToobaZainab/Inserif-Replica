{%- doc -%}
  Returns whether the selected color matches any media and the initial visible media count.

  @param {object} product - The product whose Color option values are recognized
  @param {object[]} media_items - The media items rendered by the gallery
  @param {string} aliases - Optional newline-separated color aliases
  @param {string} selected_color_key - Normalized selected Color option value

  @example
  {% render 'product-media-color-filter-state',
    product: product,
    media_items: product.media,
    aliases: block.settings.color_media_aliases,
    selected_color_key: 'black'
  %}
{%- enddoc -%}

{%- liquid
  assign has_selected_color_media = false
  assign initial_visible_media_count = media_items.size
  assign first_visible_media_index = 0

  if selected_color_key != blank
    assign selected_color_token = ',' | append: selected_color_key | append: ','

    for media in media_items
      capture media_color_keys
        render 'product-media-color-keys', product: product, media: media, aliases: aliases
      endcapture
      assign media_color_keys = media_color_keys | strip
      assign padded_media_colors = ',' | append: media_color_keys | append: ','

      if padded_media_colors contains selected_color_token
        assign has_selected_color_media = true
      endif
    endfor

    if has_selected_color_media
      assign initial_visible_media_count = 0
      assign first_visible_media_index = -1

      for media in media_items
        capture media_color_keys
          render 'product-media-color-keys', product: product, media: media, aliases: aliases
        endcapture
        assign media_color_keys = media_color_keys | strip
        assign media_is_visible = true

        if media_color_keys != blank
          assign padded_media_colors = ',' | append: media_color_keys | append: ','
          unless padded_media_colors contains selected_color_token
            assign media_is_visible = false
          endunless
        endif

        if media_is_visible
          if first_visible_media_index == -1
            assign first_visible_media_index = forloop.index0
          endif
          assign initial_visible_media_count = initial_visible_media_count | plus: 1
        endif
      endfor
    endif
  endif
-%}

{{- has_selected_color_media -}}|{{- initial_visible_media_count -}}|{{- first_visible_media_index -}}
