{%- doc -%}
  Returns the normalized selected variant value for the product's Color option.

  @param {object} product - The product whose options are inspected
  @param {object} variant - The selected or first available variant

  @example
  {% render 'product-selected-color-key', product: product, variant: product.selected_or_first_available_variant %}
{%- enddoc -%}

{%- liquid
  assign color_option_position = 0

  for product_option in product.options_with_values
    assign normalized_option_name = product_option.name | downcase | handleize | remove: '-'
    if normalized_option_name == 'color'
      assign color_option_position = product_option.position
      break
    endif
  endfor

  case color_option_position
    when 1
      assign selected_color_value = variant.option1
    when 2
      assign selected_color_value = variant.option2
    when 3
      assign selected_color_value = variant.option3
  endcase

  assign selected_color_key = selected_color_value | downcase | handleize | remove: '-'
-%}

{{- selected_color_key -}}
